# Frontend environment variables
# For local dev: copy to .env.local (never commit .env.local)
# For Vercel: add VITE_API_BASE_URL in Project Settings → Environment Variables

# API base URL
# Local:  http://localhost:8080
# Prod:   https://mealcraft-backend.onrender.com (your Render URL)
VITE_API_BASE_URL=http://localhost:8080
